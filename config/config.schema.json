{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.autocattery/config.schema.json",
  "title": "AutoCattery configuration",
  "type": "object",
  "required": [
    "schema_version",
    "mod_enabled",
    "safe_mode",
    "ui",
    "safety",
    "combat_scoring",
    "breeding_scoring",
    "classification",
    "protection",
    "room_planning"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "mod_enabled": {"type": "boolean"},
    "safe_mode": {"type": "boolean"},
    "log_level": {"enum": ["trace", "debug", "info", "warn", "error"]},
    "language": {"type": "string", "minLength": 2},
    "ui": {
      "type": "object",
      "properties": {
        "house_button_enabled": {"type": "boolean"},
        "embark_button_enabled": {"type": "boolean"},
        "show_debug_overlay": {"type": "boolean"}
      }
    },
    "safety": {
      "type": "object",
      "properties": {
        "require_preview_before_destructive_actions": {"const": true},
        "create_backup_before_apply": {"const": true},
        "abort_on_unknown_game_build": {"type": "boolean"}
      }
    },
    "combat_scoring": {
      "type": "object",
      "required": [
        "version",
        "recommended_count",
        "minimum_score",
        "minimum_known_stats",
        "stat_weights"
      ],
      "properties": {
        "version": {"const": 1},
        "recommended_count": {"type": "integer", "minimum": 0},
        "minimum_score": {"type": "number"},
        "minimum_known_stats": {"type": "integer", "minimum": 0, "maximum": 7},
        "exclude_kittens": {"type": "boolean"},
        "exclude_injured": {"type": "boolean"},
        "require_confirmed_eligibility": {"type": "boolean"},
        "missing_stat_penalty": {"type": "number"},
        "active_ability_default_weight": {"type": "number"},
        "passive_default_weight": {"type": "number"},
        "disorder_default_penalty": {"type": "number"},
        "injury_penalty": {"type": "number"},
        "stat_weights": {
          "type": "object",
          "required": [
            "strength",
            "dexterity",
            "constitution",
            "intelligence",
            "speed",
            "charisma",
            "luck"
          ],
          "properties": {
            "strength": {"type": "number"},
            "dexterity": {"type": "number"},
            "constitution": {"type": "number"},
            "intelligence": {"type": "number"},
            "speed": {"type": "number"},
            "charisma": {"type": "number"},
            "luck": {"type": "number"}
          },
          "additionalProperties": false
        },
        "active_ability_overrides": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "passive_overrides": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "disorder_overrides": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      },
      "additionalProperties": false
    },
    "breeding_scoring": {
      "type": "object",
      "required": [
        "version",
        "core_breeders",
        "reserve_breeders",
        "minimum_score",
        "minimum_known_stats",
        "stat_weights"
      ],
      "properties": {
        "version": {"const": 1},
        "core_breeders": {"type": "integer", "minimum": 0},
        "reserve_breeders": {"type": "integer", "minimum": 0},
        "minimum_score": {"type": "number"},
        "minimum_known_stats": {"type": "integer", "minimum": 0, "maximum": 7},
        "require_confirmed_eligibility": {"type": "boolean"},
        "missing_stat_penalty": {"type": "number"},
        "active_ability_default_weight": {"type": "number"},
        "passive_default_weight": {"type": "number"},
        "disorder_default_penalty": {"type": "number"},
        "stat_weights": {
          "type": "object",
          "required": [
            "strength",
            "dexterity",
            "constitution",
            "intelligence",
            "speed",
            "charisma",
            "luck"
          ],
          "properties": {
            "strength": {"type": "number"},
            "dexterity": {"type": "number"},
            "constitution": {"type": "number"},
            "intelligence": {"type": "number"},
            "speed": {"type": "number"},
            "charisma": {"type": "number"},
            "luck": {"type": "number"}
          },
          "additionalProperties": false
        },
        "active_ability_overrides": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "passive_overrides": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "disorder_overrides": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "version",
        "minimum_combat_pool",
        "minimum_breeding_pool",
        "minimum_general_reserve",
        "never_cull_if_data_confidence_below"
      ],
      "properties": {
        "version": {"const": 1},
        "combat_priority_over_breeding": {"type": "boolean"},
        "minimum_combat_pool": {"type": "integer", "minimum": 0},
        "minimum_breeding_pool": {"type": "integer", "minimum": 0},
        "minimum_general_reserve": {"type": "integer", "minimum": 0},
        "never_cull_if_data_confidence_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "protection": {
      "type": "object",
      "required": [
        "version",
        "sidecar_file",
        "protect_unknown_native_state",
        "require_stable_identity_for_sidecar"
      ],
      "properties": {
        "version": {"const": 1},
        "sidecar_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/\\\\]+\\.json$"
        },
        "protect_unknown_native_state": {"const": true},
        "require_stable_identity_for_sidecar": {"const": true}
      },
      "additionalProperties": false
    },
    "room_planning": {
      "type": "object",
      "required": [
        "version",
        "default_soft_capacity",
        "allow_soft_overflow",
        "max_soft_overflow_per_room",
        "never_exceed_known_hard_capacity",
        "prefer_single_combat_staging_room",
        "keep_breeding_pairs_together",
        "avoid_inbreeding_pairs",
        "keep_kittens_separate_when_possible",
        "allow_partial_plan"
      ],
      "properties": {
        "version": {"const": 1},
        "default_soft_capacity": {"type": "integer", "minimum": 1},
        "allow_soft_overflow": {"type": "boolean"},
        "max_soft_overflow_per_room": {"type": "integer", "minimum": 0},
        "never_exceed_known_hard_capacity": {"const": true},
        "prefer_single_combat_staging_room": {"type": "boolean"},
        "keep_breeding_pairs_together": {"type": "boolean"},
        "avoid_inbreeding_pairs": {"type": "boolean"},
        "keep_kittens_separate_when_possible": {"type": "boolean"},
        "allow_partial_plan": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
