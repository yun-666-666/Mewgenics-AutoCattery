{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.autocattery/config.schema.json",
  "title": "AutoCattery configuration",
  "type": "object",
  "required": ["schema_version", "mod_enabled", "safe_mode", "ui", "safety"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "mod_enabled": {"type": "boolean"},
    "safe_mode": {"type": "boolean"},
    "log_level": {"enum": ["trace", "debug", "info", "warn", "error"]},
    "language": {"type": "string", "minLength": 2},
    "ui": {
      "type": "object",
      "properties": {
        "house_button_enabled": {"type": "boolean"},
        "embark_button_enabled": {"type": "boolean"},
        "show_debug_overlay": {"type": "boolean"}
      }
    },
    "recommendation_marker": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "show_rank": {"type": "boolean"},
        "show_score": {"type": "boolean"},
        "pulse": {"type": "boolean"},
        "pulse_period_ms": {"type": "integer", "minimum": 100},
        "max_markers": {"type": "integer", "minimum": 1},
        "fallback_to_text_prefix": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "properties": {
        "require_preview_before_destructive_actions": {"const": true},
        "create_backup_before_apply": {"const": true},
        "abort_on_unknown_game_build": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": true
}
