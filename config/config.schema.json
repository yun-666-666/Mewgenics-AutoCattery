{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.autocattery/config.schema.json",
  "title": "AutoCattery configuration",
  "type": "object",
  "required": [
    "schema_version",
    "general",
    "ui",
    "execution_safety",
    "execution",
    "workflow",
    "combat_scoring",
    "breeding_scoring",
    "classification",
    "protection",
    "room_planning",
    "recommendation_marker",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "general": {
      "type": "object",
      "required": ["version", "mod_enabled", "safe_mode", "log_level", "language"],
      "properties": {
        "version": {"const": 1},
        "mod_enabled": {"type": "boolean"},
        "safe_mode": {"type": "boolean"},
        "log_level": {"enum": ["trace", "debug", "info", "warn", "error"]},
        "language": {"type": "string", "minLength": 2, "maxLength": 32}
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "required": [
        "version",
        "house_button_enabled",
        "embark_button_enabled",
        "show_debug_overlay"
      ],
      "properties": {
        "version": {"const": 1},
        "house_button_enabled": {"type": "boolean"},
        "embark_button_enabled": {"type": "boolean"},
        "show_debug_overlay": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "execution_safety": {
      "type": "object",
      "required": [
        "version",
        "require_preview_before_destructive_actions",
        "create_backup_before_apply",
        "read_only_mode",
        "single_click_execute",
        "abort_on_unknown_game_build"
      ],
      "properties": {
        "version": {"const": 1},
        "require_preview_before_destructive_actions": {"const": true},
        "create_backup_before_apply": {"type": "boolean"},
        "read_only_mode": {"type": "boolean"},
        "single_click_execute": {"type": "boolean"},
        "abort_on_unknown_game_build": {"const": true}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "real_write_adapter_enabled",
        "cull_enabled",
        "require_quiescent_backup"
      ],
      "properties": {
        "real_write_adapter_enabled": {"const": false},
        "cull_enabled": {"const": false},
        "require_quiescent_backup": {"const": true}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["preview_ttl_seconds"],
      "properties": {
        "preview_ttl_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        }
      },
      "additionalProperties": false
    },
    "combat_scoring": {
      "type": "object",
      "required": [
        "version",
        "recommended_count",
        "minimum_score",
        "minimum_known_stats",
        "stat_weights"
      ],
      "properties": {
        "version": {"const": 1},
        "recommended_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "minimum_score": {"type": "number", "minimum": -10000, "maximum": 10000},
        "minimum_known_stats": {"type": "integer", "minimum": 0, "maximum": 7},
        "exclude_kittens": {"type": "boolean"},
        "exclude_injured": {"type": "boolean"},
        "require_confirmed_eligibility": {"type": "boolean"},
        "missing_stat_penalty": {"type": "number", "minimum": -10000, "maximum": 10000},
        "active_ability_default_weight": {"type": "number", "minimum": -10000, "maximum": 10000},
        "passive_default_weight": {"type": "number", "minimum": -10000, "maximum": 10000},
        "disorder_default_penalty": {"type": "number", "minimum": -10000, "maximum": 10000},
        "injury_penalty": {"type": "number", "minimum": -10000, "maximum": 10000},
        "stat_weights": {"$ref": "#/$defs/stat_weights"},
        "active_ability_overrides": {"$ref": "#/$defs/weights"},
        "passive_overrides": {"$ref": "#/$defs/weights"},
        "disorder_overrides": {"$ref": "#/$defs/weights"}
      },
      "additionalProperties": false
    },
    "breeding_scoring": {
      "type": "object",
      "required": [
        "version",
        "core_breeders",
        "reserve_breeders",
        "minimum_score",
        "minimum_known_stats",
        "stat_weights"
      ],
      "properties": {
        "version": {"const": 1},
        "core_breeders": {"type": "integer", "minimum": 0, "maximum": 10000},
        "reserve_breeders": {"type": "integer", "minimum": 0, "maximum": 10000},
        "minimum_score": {"type": "number", "minimum": -10000, "maximum": 10000},
        "minimum_known_stats": {"type": "integer", "minimum": 0, "maximum": 7},
        "require_confirmed_eligibility": {"type": "boolean"},
        "missing_stat_penalty": {"type": "number", "minimum": -10000, "maximum": 10000},
        "active_ability_default_weight": {"type": "number", "minimum": -10000, "maximum": 10000},
        "passive_default_weight": {"type": "number", "minimum": -10000, "maximum": 10000},
        "disorder_default_penalty": {"type": "number", "minimum": -10000, "maximum": 10000},
        "mutation_default_weight": {"type": "number", "minimum": -10000, "maximum": 10000},
        "birth_defect_default_penalty": {"type": "number", "minimum": -10000, "maximum": 10000},
        "stat_weights": {"$ref": "#/$defs/stat_weights"},
        "active_ability_overrides": {"$ref": "#/$defs/weights"},
        "passive_overrides": {"$ref": "#/$defs/weights"},
        "disorder_overrides": {"$ref": "#/$defs/weights"},
        "mutation_overrides": {"$ref": "#/$defs/weights"},
        "birth_defect_overrides": {"$ref": "#/$defs/weights"}
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": [
        "version",
        "minimum_combat_pool",
        "minimum_breeding_pool",
        "minimum_general_reserve",
        "never_cull_if_data_confidence_below"
      ],
      "properties": {
        "version": {"const": 1},
        "combat_priority_over_breeding": {"type": "boolean"},
        "minimum_combat_pool": {"type": "integer", "minimum": 0, "maximum": 10000},
        "minimum_breeding_pool": {"type": "integer", "minimum": 0, "maximum": 10000},
        "minimum_general_reserve": {"type": "integer", "minimum": 0, "maximum": 10000},
        "never_cull_if_data_confidence_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "protection": {
      "type": "object",
      "required": [
        "version",
        "sidecar_file",
        "protect_unknown_native_state",
        "require_stable_identity_for_sidecar"
      ],
      "properties": {
        "version": {"const": 1},
        "sidecar_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/\\\\]+\\.json$"
        },
        "protect_unknown_native_state": {"const": true},
        "require_stable_identity_for_sidecar": {"const": true}
      },
      "additionalProperties": false
    },
    "room_planning": {
      "type": "object",
      "required": [
        "version",
        "default_soft_capacity",
        "allow_soft_overflow",
        "max_soft_overflow_per_room",
        "never_exceed_known_hard_capacity",
        "prefer_single_combat_staging_room",
        "keep_breeding_pairs_together",
        "avoid_inbreeding_pairs",
        "keep_kittens_separate_when_possible",
        "allow_partial_plan"
      ],
      "properties": {
        "version": {"const": 1},
        "default_soft_capacity": {"type": "integer", "minimum": 1, "maximum": 1000},
        "allow_soft_overflow": {"type": "boolean"},
        "max_soft_overflow_per_room": {"type": "integer", "minimum": 0, "maximum": 1000},
        "never_exceed_known_hard_capacity": {"const": true},
        "prefer_single_combat_staging_room": {"type": "boolean"},
        "keep_breeding_pairs_together": {"type": "boolean"},
        "avoid_inbreeding_pairs": {"type": "boolean"},
        "keep_kittens_separate_when_possible": {"type": "boolean"},
        "allow_partial_plan": {"const": true}
      },
      "additionalProperties": false
    },
    "recommendation_marker": {
      "type": "object",
      "required": [
        "version",
        "recommended_count",
        "show_score",
        "show_rank",
        "pulse_top_n",
        "auto_clear_on_scene_exit",
        "recompute_if_stale",
        "never_auto_select"
      ],
      "properties": {
        "version": {"const": 1},
        "recommended_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "show_score": {"type": "boolean"},
        "show_rank": {"type": "boolean"},
        "pulse_top_n": {"const": 0},
        "auto_clear_on_scene_exit": {"const": true},
        "recompute_if_stale": {"const": true},
        "never_auto_select": {"const": true}
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "required": ["version", "show_debug_overlay", "export_scene_summary_enabled"],
      "properties": {
        "version": {"const": 1},
        "show_debug_overlay": {"type": "boolean"},
        "export_scene_summary_enabled": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stat_weights": {
      "type": "object",
      "required": [
        "strength",
        "dexterity",
        "constitution",
        "intelligence",
        "speed",
        "charisma",
        "luck"
      ],
      "properties": {
        "strength": {"type": "number", "minimum": -10000, "maximum": 10000},
        "dexterity": {"type": "number", "minimum": -10000, "maximum": 10000},
        "constitution": {"type": "number", "minimum": -10000, "maximum": 10000},
        "intelligence": {"type": "number", "minimum": -10000, "maximum": 10000},
        "speed": {"type": "number", "minimum": -10000, "maximum": 10000},
        "charisma": {"type": "number", "minimum": -10000, "maximum": 10000},
        "luck": {"type": "number", "minimum": -10000, "maximum": 10000}
      },
      "additionalProperties": false
    },
    "weights": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {"minLength": 1, "maxLength": 128},
      "additionalProperties": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      }
    }
  },
  "additionalProperties": false
}
